# Variáveis de ambiente para testes (valores fictícios).
# Os testes unitários usam um mock do Prisma (ver __tests__/mocks/prismaMock.js),
# então NENHUM banco real é acessado. Este arquivo apenas garante que os testes
# nunca caiam no DATABASE_URL do .env de desenvolvimento.
NODE_ENV=test
DATABASE_URL="postgresql://test:test@localhost:5432/test_db?schema=public"
JWT_SECRET_TOKEN=test-secret
JWT_REFRESH_TOKEN=test-refresh-secret
JWT_EXP_SECONDS=604800
JWT_REFRESH_EXP_SECONDS=2592000
