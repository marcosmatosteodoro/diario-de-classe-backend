]# === CONFIGURAÇÃO DA APLICAÇÃO ===
NODE_ENV=development
PORT=3000
ENV_CHECK=development
NAME=diario-de-classe-backend

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# === CONFIGURAÇÃO DO BANCO DE DADOS ===
# Tipo de banco: sqlite, postgresql, mysql
DATABASE_PROVIDER="sqlite"

# URL de conexão do banco
DATABASE_URL="file:./src/db/dev.db"

# === CONFIGURAÇÕES POR TIPO DE BANCO ===
# SQLite (Desenvolvimento)
SQLITE_DATABASE_PATH="./src/db/dev.db"

# PostgreSQL (Produção)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DATABASE="diario_classe"
POSTGRES_USER="seu_usuario"
POSTGRES_PASSWORD="sua_senha"
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}"

# MySQL (Alternativa)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="diario_classe"
MYSQL_USER="seu_usuario"
MYSQL_PASSWORD="sua_senha"
# DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"

# === OUTRAS CONFIGURAÇÕES ===
# NEW_RELIC_LICENSE_KEY="sua_license_key_aqui"
# NEW_RELIC_APP_NAME="diario-de-classe-backend"

# JWT SECRETS
JWT_SECRET_TOKEN="sua_chave_secreta_jwt_aqui"
JWT_REFRESH_TOKEN="sua_chave_secreta_jwt_refresh_aqui"
JWT_EXP_SECONDS=3600 # 1 hora
JWT_REFRESH_EXP_SECONDS=604800 # 7 dias