]# === CONFIGURAÇÃO DA APLICAÇÃO ===
NODE_ENV=development
PORT=3000
ENV_CHECK=development
NAME=diario-de-classe-backend

# CORS: origens permitidas, separadas por vírgula (origem exata, sem barra final). Obrigatória em produção.
# Segundo uso: origens do app aceitas pela verificação de origem de entrar, renovar e sair da sessão
# (/api/auth/login, /api/auth/refresh-token e /api/auth/logout); a origem pública do app precisa estar
# aqui em produção, senão o login recusa todo mundo.
CORS_ORIGINS=http://localhost:3001

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Senha dos usuários criados por `npm run db:seed` (obrigatória para o seed; ele recusa produção)
SEED_PASSWORD=troque-por-uma-senha-de-seed-ficticia

# === CONFIGURAÇÃO DO BANCO DE DADOS ===
# Tipo de banco: sqlite, postgresql, mysql
DATABASE_PROVIDER="sqlite"

# URL de conexão do banco
DATABASE_URL="file:./src/db/dev.db"

# === CONFIGURAÇÕES POR TIPO DE BANCO ===
# SQLite (Desenvolvimento)
SQLITE_DATABASE_PATH="./src/db/dev.db"

# PostgreSQL (Produção)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DATABASE="diario_classe"
POSTGRES_USER="seu_usuario"
POSTGRES_PASSWORD="sua_senha"
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}"

# MySQL (Alternativa)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="diario_classe"
MYSQL_USER="seu_usuario"
MYSQL_PASSWORD="sua_senha"
# DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"

# JWT SECRETS
JWT_SECRET_TOKEN="sua_chave_secreta_jwt_aqui"
JWT_REFRESH_TOKEN="sua_chave_secreta_jwt_refresh_aqui"
JWT_EXP_SECONDS=900 # 15 minutos
JWT_REFRESH_EXP_SECONDS=604800 # 7 dias
# Opcional: tolerância (segundos) de concorrência da renovação do refresh; default 30
SESSION_ROTATION_GRACE_SECONDS=30

# LIMITE DE TENTATIVAS DE LOGIN (valores abaixo = default)
LOGIN_MAX_TENTATIVAS_POR_EMAIL=5
LOGIN_MAX_TENTATIVAS_POR_IP=30
LOGIN_JANELA_SEGUNDOS=900
# Opcional: número de proxies confiáveis à frente da app (inteiro >= 0). Com um
# proxy/LB na frente use TRUST_PROXY=1; `true` não é aceito.
# Sem esta variável, o IP considerado é o da conexão direta.
# TRUST_PROXY=1

# Opcional: modo demonstração. Só o texto exato `true` liga; qualquer outro valor desliga.
# Descomente apenas no ambiente de demonstração.
# DEMO_MODE=true
# Opcional: e-mails das contas fixas da demonstração, separados por vírgula. Use minúsculas e
# exatamente os e-mails do seed (a comparação não normaliza a caixa).
# DEMO_CONTAS_FIXAS=admin.demo@example.com,professor.demo@example.com
