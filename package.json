{
  "name": "diario-de-classe-backend",
  "version": "1.2.2",
  "description": "Api do diário de classe",
  "main": "app.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "start:docker": "docker compose -f docker-compose.app-only.yml up --build",
    "start:db": "docker compose -f docker-compose.yml up --build",
    "dev": "nodemon src/server.js",
    "server": "git pull && npm install && npm run db:generate && npm run db:migrate && npm run db:push && npm run start",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest __tests__/units",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest __tests__/integrations",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema=./src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./src/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./src/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./src/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=./src/db/prisma/schema.prisma",
    "db:seed": "node src/db/seeds/seed.js",
    "clean:uploads": "node scripts/deleteUploadFiles.js",
    "prepare": "husky || echo 'Husky not found, skipping...'",
    "build": "npm run db:generate",
    "vercel-build": "npm run db:generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLS-idiomas/diario-de-classe-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BLS-idiomas/diario-de-classe-backend/issues"
  },
  "homepage": "https://github.com/BLS-idiomas/diario-de-classe-backend#readme",
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "body-parser": "^2.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "custom-env": "^2.0.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "i18next": "^25.6.0",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.8.1",
    "method-override": "^3.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "newrelic": "^13.6.2",
    "prisma": "^6.18.0",
    "response-time": "^2.3.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@jest/globals": "^30.2.0",
    "semantic-release": "^24.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
