// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Permissao {
  member
  admin
}

enum DiaDaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model User {
  id              String    @id @default(cuid())
  nome            String // máximo 255 caracteres
  sobrenome       String // máximo 255 caracteres
  email           String    @unique // máximo 255 caracteres
  telefone        String? // máximo 11 caracteres
  senha           String
  resetarSenha    Boolean   @default(false)
  permissao       Permissao @default(member)
  dataCriacao     DateTime  @default(now())
  dataAtualizacao DateTime  @updatedAt

  // Relacionamento com DisponibilidadeProfessor
  disponibilidades DisponibilidadeProfessor[]

  @@map("users")
}

model DisponibilidadeProfessor {
  id          String      @id @default(cuid())
  diaDaSemana DiaDaSemana
  horaInicial String
  horaFinal   String
  ativo       Boolean     @default(true)
  userId      String

  // Relacionamento com User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disponibilidades_professor")
}

model Aluno {
  id              String   @id @default(cuid())
  nome            String // máximo 255 caracteres
  sobrenome       String // máximo 255 caracteres
  email           String   @unique // máximo 255 caracteres
  telefone        String? // máximo 11 caracteres
  criador         String? // ID do usuário que criou o aluno
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  @@map("alunos")
}

model Configuracao {
  id                  String @id @default(cuid())
  duracaoDaAula       Int
  tolerancia          Int
  diasDeFuncionamento String // ID do DiaDeFuncionamento

  // Relacionamento
  diaDeFuncionamento DiaDeFuncionamento @relation(fields: [diasDeFuncionamento], references: [id])

  @@map("configuracoes")
}

model DiaDeFuncionamento {
  id          String      @id @default(cuid())
  diaDaSemana DiaDaSemana
  horaInicial String
  horaFinal   String
  ativo       Boolean     @default(true)

  // Relacionamento com Configuracao
  configuracao Configuracao[]

  @@map("dias_funcionamento")
}
