// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Permissao {
  member
  admin
}

enum DiaDaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

enum StatusContrato {
  PENDENTE
  ATIVO
  INATIVO
  CANCELADO
}

model User {
  id              String    @id @default(cuid())
  nome            String // máximo 255 caracteres
  sobrenome       String // máximo 255 caracteres
  email           String    @unique // máximo 255 caracteres
  telefone        String? // máximo 11 caracteres
  senha           String
  resetarSenha    Boolean   @default(false)
  permissao       Permissao @default(member)
  dataCriacao     DateTime  @default(now())
  dataAtualizacao DateTime  @updatedAt

  // Relacionamento com DisponibilidadeProfessor
  disponibilidades DisponibilidadeProfessor[]

  @@map("users")
}

model DisponibilidadeProfessor {
  id          String      @id @default(cuid())
  diaDaSemana DiaDaSemana
  horaInicial String
  horaFinal   String
  ativo       Boolean     @default(true)
  userId      String

  // Relacionamento com User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disponibilidades_professor")
}

model Aluno {
  id              String   @id @default(cuid())
  nome            String // máximo 255 caracteres
  sobrenome       String // máximo 255 caracteres
  email           String   @unique // máximo 255 caracteres
  telefone        String? // máximo 11 caracteres
  criador         String? // ID do usuário que criou o aluno
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  // Relacionamento com Contrato
  contratoes Contrato[]
  // Relacionamento com DiaAula
  diaAulas   DiaAula[]

  @@map("alunos")
}

model Configuracao {
  id                  String               @id @default(cuid())
  duracaoDaAula       Int
  tolerancia          Int
  // Relacionamento com DiaDeFuncionamento
  diasDeFuncionamento DiaDeFuncionamento[]

  @@map("configuracoes")
}

model DiaDeFuncionamento {
  id             String      @id @default(cuid())
  diaDaSemana    DiaDaSemana
  horaInicial    String
  horaFinal      String
  ativo          Boolean     @default(true)
  configuracaoId String

  // Relacionamento com Configuracao
  configuracao Configuracao @relation(fields: [configuracaoId], references: [id], onDelete: Cascade)

  @@map("dias_funcionamento")
}

model Contrato {
  id                   String         @id @default(cuid())
  idDoAluno            String
  dataDeInicio         DateTime
  dataDeTermino        DateTime
  status               StatusContrato
  totalAulas           Int // Sistema preenche automático
  totalAulasFeitas     Int // Sistema preenche automático
  totalReposicoes      Int // Sistema preenche automático
  totalFaltas          Int // Sistema preenche automático
  totalAulasCanceladas Int // Sistema preenche automático

  // Relacionamento com Aluno
  aluno    Aluno     @relation(fields: [idDoAluno], references: [id], onDelete: Cascade)
  // Relacionamento com DiaAula
  diaAulas DiaAula[]

  @@map("contratos")
}

model DiaAula {
  id                String      @id @default(cuid())
  idAluno           String
  idContrato        String
  diaDaSemana       DiaDaSemana
  quantidadeDeAulas Int
  horaDeInicio      String
  horaDeFim         String // Sistema preenche automático

  // Relacionamento com Aluno
  aluno    Aluno    @relation(fields: [idAluno], references: [id], onDelete: Cascade)
  // Relacionamento com Contrato
  contrato Contrato @relation(fields: [idContrato], references: [id], onDelete: Cascade)

  @@map("dias_aula")
}
