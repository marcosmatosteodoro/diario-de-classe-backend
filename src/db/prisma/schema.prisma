// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Idioma {
  INGLES
  ESPANHOL
  FRANCES
}

enum Permissao {
  member
  admin
}

enum DiaDaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

enum StatusContrato {
  PENDENTE
  ATIVO
  INATIVO
  CANCELADO
}

enum TipoAula {
  PADRAO
  REPOSICAO
  OUTRA
}

enum StatusAula {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  CANCELADA_POR_FALTA
}

model User {
  id              String    @id @default(cuid())
  nome            String // máximo 255 caracteres
  sobrenome       String // máximo 255 caracteres
  nomeCompleto    String? // máximo 255 caracteres
  email           String    @unique // máximo 255 caracteres
  telefone        String? // máximo 11 caracteres
  senha           String
  resetarSenha    Boolean   @default(false)
  permissao       Permissao @default(member)
  dataCriacao     DateTime  @default(now())
  dataAtualizacao DateTime  @updatedAt

  // Relacionamento com DisponibilidadeProfessor
  disponibilidades DisponibilidadeProfessor[]
  // Relacionamento com Aula
  aulas            Aula[]
  // Relacionamento com Idiomas
  idiomas          Idioma[]

  @@map("users")
}

model DisponibilidadeProfessor {
  id              String      @id @default(cuid())
  diaSemana       DiaDaSemana
  horaInicial     String
  horaFinal       String
  ativo           Boolean     @default(true)
  userId          String
  dataCriacao     DateTime    @default(now())
  dataAtualizacao DateTime    @updatedAt

  // Relacionamento com User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disponibilidades_professor")
}

model Aluno {
  id              String   @id @default(cuid())
  nome            String // máximo 255 caracteres
  sobrenome       String // máximo 255 caracteres
  nomeCompleto    String? // máximo 255 caracteres
  email           String   @unique // máximo 255 caracteres
  telefone        String? // máximo 11 caracteres
  material        String? // campo extenso para armazenar informações sobre material
  criador         String? // ID do usuário que criou o aluno
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  // Relacionamento com Contrato
  contratoes  Contrato[]
  // Relacionamento com DiaAula
  diaAulas    DiaAula[]
  // Relacionamento com Aula
  aulas       Aula[]
  // Relacionamento com CronogramaAluno
  cronogramas CronogramaAluno[]

  @@map("alunos")
}

model Configuracao {
  id              String   @id @default(cuid())
  duracaoAula     Int
  tolerancia      Int
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  // Relacionamento com DiaDeFuncionamento
  diasDeFuncionamento DiaDeFuncionamento[]

  @@map("configuracoes")
}

model DiaDeFuncionamento {
  id              String      @id @default(cuid())
  diaSemana       DiaDaSemana
  horaInicial     String
  horaFinal       String
  ativo           Boolean     @default(true)
  configuracaoId  String
  dataCriacao     DateTime    @default(now())
  dataAtualizacao DateTime    @updatedAt

  // Relacionamento com Configuracao
  configuracao Configuracao @relation(fields: [configuracaoId], references: [id], onDelete: Cascade)

  @@map("dias_funcionamento")
}

model Contrato {
  id                   String         @id @default(cuid())
  idAluno              String
  dataInicio           DateTime?
  dataTermino          DateTime?
  status               StatusContrato
  totalAulas           Int // Sistema preenche automático
  totalAulasFeitas     Int // Sistema preenche automático
  totalReposicoes      Int // Sistema preenche automático
  totalFaltas          Int // Sistema preenche automático
  totalAulasCanceladas Int // Sistema preenche automático
  dataCriacao          DateTime       @default(now())
  dataAtualizacao      DateTime       @updatedAt

  // Relacionamento com Aluno
  aluno       Aluno             @relation(fields: [idAluno], references: [id], onDelete: Cascade)
  // Relacionamento com DiaAula
  diaAulas    DiaAula[]
  // Relacionamento com Aula
  aulas       Aula[]
  // Relacionamento com Idioma
  idioma      Idioma            @default(INGLES)
  // Relacionamento com CronogramaAluno
  cronogramas CronogramaAluno[]

  @@map("contratos")
}

model DiaAula {
  id              String      @id @default(cuid())
  idAluno         String
  idContrato      String
  diaSemana       DiaDaSemana
  quantidadeAulas Int
  duracaoAula     Int?
  horaInicial     String
  horaFinal       String // Sistema preenche automático
  dataCriacao     DateTime    @default(now())
  dataAtualizacao DateTime    @updatedAt

  // Relacionamento com Aluno
  aluno    Aluno    @relation(fields: [idAluno], references: [id], onDelete: Cascade)
  // Relacionamento com Contrato
  contrato Contrato @relation(fields: [idContrato], references: [id], onDelete: Cascade)

  @@map("dias_aula")
}

model Aula {
  id              String     @id @default(cuid())
  idAluno         String
  idProfessor     String
  idContrato      String
  dataAula        DateTime
  horaInicial     String
  horaFinal       String
  duracaoAula     Int?
  tipo            TipoAula
  status          StatusAula
  observacao      String?
  // Conteudo do livro coberto nesta aula. Opcional porque as aulas anteriores a
  // este recurso nao possuem vinculo e porque aula do tipo OUTRA nao consome
  // conteudo. A sequencia e derivada: ver ResequenciarCronogramaService.
  idConteudo      String?
  // Marca que o vinculo foi escolhido a mao pelo professor. O resequenciador
  // nunca sobrescreve uma aula marcada, senao desfaria a escolha dele no
  // proximo disparo.
  conteudoManual  Boolean    @default(false)
  dataCriacao     DateTime   @default(now())
  dataAtualizacao DateTime   @updatedAt

  // Relacionamento com Aluno
  aluno     Aluno          @relation(fields: [idAluno], references: [id], onDelete: Cascade)
  // Relacionamento com Professor
  professor User           @relation(fields: [idProfessor], references: [id], onDelete: Cascade)
  // Relacionamento com Contrato
  contrato  Contrato       @relation(fields: [idContrato], references: [id], onDelete: Cascade)
  // Relacionamento com ConteudoLivro
  conteudo  ConteudoLivro? @relation(fields: [idConteudo], references: [id], onDelete: SetNull)

  @@unique([idAluno, idProfessor, idContrato, dataAula])
  @@index([idConteudo])
  @@map("aulas")
}

model Livro {
  id              String   @id @default(cuid())
  nome            String // maximo 255 caracteres
  idioma          Idioma
  nivel           Int? // ordem do livro na trilha do idioma
  ativo           Boolean  @default(true)
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  // Relacionamento com ConteudoLivro
  conteudos   ConteudoLivro[]
  // Relacionamento com CronogramaAluno
  cronogramas CronogramaAluno[]

  @@unique([nome, idioma])
  @@map("livros")
}

model ConteudoLivro {
  id              String   @id @default(cuid())
  idLivro         String
  ordem           Int // "aula um, aula dois, aula tres..." dentro do livro
  titulo          String // maximo 255 caracteres
  descricao       String? // conteudo/tarefa detalhada
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  // Relacionamento com Livro
  livro Livro  @relation(fields: [idLivro], references: [id], onDelete: Cascade)
  // Relacionamento com Aula
  aulas Aula[]

  @@unique([idLivro, ordem])
  @@index([idLivro])
  @@map("conteudos_livro")
}

model CronogramaAluno {
  id              String    @id @default(cuid())
  idAluno         String
  idContrato      String
  idLivro         String
  dataInicio      DateTime // quando o aluno entrou neste livro
  dataConclusao   DateTime?
  ativo           Boolean   @default(true)
  dataCriacao     DateTime  @default(now())
  dataAtualizacao DateTime  @updatedAt

  // Relacionamento com Aluno
  aluno    Aluno    @relation(fields: [idAluno], references: [id], onDelete: Cascade)
  // Relacionamento com Contrato
  contrato Contrato @relation(fields: [idContrato], references: [id], onDelete: Cascade)
  // Relacionamento com Livro
  livro    Livro    @relation(fields: [idLivro], references: [id])

  @@index([idAluno])
  @@index([idContrato])
  @@map("cronogramas_aluno")
}
