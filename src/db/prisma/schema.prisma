// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Permissao {
  member
  admin
}

model User {
  id              String    @id @default(cuid())
  nome            String // máximo 255 caracteres
  sobrenome       String // máximo 255 caracteres
  email           String    @unique // máximo 255 caracteres
  telefone        String? // máximo 11 caracteres
  senha           String
  resetarSenha    Boolean   @default(false)
  permissao       Permissao @default(member)
  dataCriacao     DateTime  @default(now())
  dataAtualizacao DateTime  @updatedAt

  @@map("users")
}
